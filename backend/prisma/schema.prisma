// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. AUTHENTICATION & USERS
// ============================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  username            String?   @unique
  passwordHash        String    @map("password_hash")
  fullName            String?   @map("full_name")
  phone               String?
  profilePhotoUrl     String?   @map("profile_photo_url")
  isActive            Boolean   @default(true) @map("is_active")
  isVerified          Boolean   @default(false) @map("is_verified")
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?   @map("two_factor_secret")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  // Relations
  userRoles         UserRole[]
  employee          Employee?
  cashierTransactions SalesTransaction[]
  heldTransactions  HeldTransaction[]
  assignedServices  ServiceOrder[] @relation("ServiceTechnician")

  @@index([email])
  @@index([username])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  level        Int // Hierarchical level (0=SUPERADMIN, 1=OWNER, etc.)
  isSystemRole Boolean  @default(false) @map("is_system_role")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([code])
  @@index([level])
  @@index([isActive])
  @@map("roles")
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  branchId   String?   @map("branch_id") // null = all branches
  isPrimary  Boolean   @default(false) @map("is_primary")
  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until") // null = no expiration
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([roleId])
  @@index([branchId])
  @@index([isPrimary])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String // e.g., "inventory", "sales", "service"
  submodule   String? // e.g., "stock_transfer", "pos", "repair"
  action      String // e.g., "view", "create", "edit", "delete", "approve", "export"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@unique([module, submodule, action])
  @@index([module])
  @@index([submodule])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id               String   @id @default(uuid())
  roleId           String   @map("role_id")
  permissionId     String   @map("permission_id")
  maxAmount        Decimal? @map("max_amount") @db.Decimal(15, 2) // For amount-based permissions
  requiresApproval Boolean  @default(false) @map("requires_approval")
  conditions       Json? // JSONB for flexible conditions (e.g., {"approverRoles": ["HS", "SPV"]})
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================
// 2. ORGANIZATION
// ============================================

model Branch {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  type           String // e.g., "store", "warehouse", "office"
  phone          String?
  email          String?
  address        String?
  city           String?
  province       String?
  isActive       Boolean  @default(true) @map("is_active")
  isWarehouse    Boolean  @default(false) @map("is_warehouse") // Warehouse capability flag
  operatingHours Json?    @map("operating_hours") // JSONB: {"monday": {"open": "08:00", "close": "22:00"}, ...}
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles         UserRole[]
  departments       Department[]
  productStocks     ProductStock[]
  preferredCustomers Customer[]
  salesTransactions SalesTransaction[]
  stockMovements    StockMovement[]
  heldTransactions  HeldTransaction[]
  stockTransfersFrom StockTransfer[] @relation("StockTransferFrom")
  stockTransfersTo   StockTransfer[] @relation("StockTransferTo")
  stockOpnames        StockOpname[]
  serviceOrders       ServiceOrder[]

  @@index([code])
  @@index([isActive])
  @@map("branches")
}

model Department {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  parentDepartmentId String?  @map("parent_department_id") // For hierarchical structure
  branchId           String?  @map("branch_id") // null = company-wide department
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments Department[] @relation("DepartmentHierarchy")
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([parentDepartmentId])
  @@index([branchId])
  @@index([isActive])
  @@map("departments")
}

// ============================================
// 3. PRODUCTS & INVENTORY
// ============================================

model Category {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  parentCategoryId String?  @map("parent_category_id") // For hierarchical categories
  description      String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  parentCategory  Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories Category[] @relation("CategoryHierarchy")
  products        Product[]

  @@index([code])
  @@index([parentCategoryId])
  @@index([isActive])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  logoUrl     String?  @map("logo_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  products Product[]

  @@index([code])
  @@index([isActive])
  @@map("brands")
}

model Product {
  id            String    @id @default(uuid())
  barcode       String?   @unique
  sku           String    @unique
  name          String
  categoryId    String    @map("category_id")
  brandId       String?   @map("brand_id")
  costPrice     Decimal   @map("cost_price") @db.Decimal(15, 2)
  sellingPrice  Decimal   @map("selling_price") @db.Decimal(15, 2)
  unit          String    @default("pcs") // e.g., "pcs", "box", "kg"
  isActive      Boolean   @default(true) @map("is_active")
  trackSerial   Boolean   @default(false) @map("track_serial") // Track by serial number
  trackBatch    Boolean   @default(false) @map("track_batch") // Track by batch number
  memberPricing Json?     @map("member_pricing") // JSONB: {"platinum": {"discount": 10}, "gold": {"discount": 5}, ...}
  images        Json? // JSONB array: ["url1", "url2", ...]
  description   String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  category        Category           @relation(fields: [categoryId], references: [id])
  brand           Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productStocks   ProductStock[]
  transactionItems SalesTransactionItem[]
  stockMovements  StockMovement[]
  transferItems   StockTransferItem[]
  opnameItems     StockOpnameItem[]
  servicePartsUsed ServicePartsUsed[]

  @@index([barcode])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("products")
}

model ProductStock {
  id                String   @id @default(uuid())
  productId         String   @map("product_id")
  branchId          String   @map("branch_id")
  quantityAvailable Decimal  @default(0) @map("quantity_available") @db.Decimal(15, 3)
  quantityReserved  Decimal  @default(0) @map("quantity_reserved") @db.Decimal(15, 3)
  quantityDamaged   Decimal  @default(0) @map("quantity_damaged") @db.Decimal(15, 3)
  minStock          Decimal? @map("min_stock") @db.Decimal(15, 3)
  maxStock          Decimal? @map("max_stock") @db.Decimal(15, 3)
  reorderPoint      Decimal? @map("reorder_point") @db.Decimal(15, 3)
  branchPrice       Decimal? @map("branch_price") @db.Decimal(15, 2) // Branch-specific pricing override
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
  @@index([reorderPoint])
  @@map("product_stock")
}

// ============================================
// 4. CUSTOMERS
// ============================================

model CustomerTier {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  discountPercentage Decimal @map("discount_percentage") @db.Decimal(5, 2) // e.g., 15.00 for 15%
  creditLimit Decimal  @map("credit_limit") @db.Decimal(15, 2)
  minPurchaseAmount Decimal? @map("min_purchase_amount") @db.Decimal(15, 2) // Minimum purchase to qualify
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  customers Customer[]

  @@index([code])
  @@index([isActive])
  @@map("customer_tiers")
}

model Customer {
  id                String    @id @default(uuid())
  customerCode      String    @unique @map("customer_code")
  customerType      String    @map("customer_type") // 'retail', 'wholesale', 'corporate'
  tierId            String?   @map("tier_id")
  name              String
  email             String?
  phone             String
  alternatePhone    String?   @map("alternate_phone")
  dateOfBirth       DateTime? @map("date_of_birth")
  gender            String? // 'L', 'P'
  address           String?
  city              String?
  province          String?
  postalCode        String?   @map("postal_code")
  country           String?   @default("Indonesia")
  taxId             String?   @map("tax_id") // NPWP
  taxName           String?   @map("tax_name")
  taxAddress        String?   @map("tax_address")
  creditLimit       Decimal   @default(0) @map("credit_limit") @db.Decimal(15, 2)
  creditUsed        Decimal   @default(0) @map("credit_used") @db.Decimal(15, 2)
  paymentTermDays   Int?      @map("payment_term_days")
  preferredBranchId String?   @map("preferred_branch_id")
  isBlacklisted     Boolean   @default(false) @map("is_blacklisted")
  blacklistReason   String?   @map("blacklist_reason")
  blacklistUntil    DateTime? @map("blacklist_until")
  isActive          Boolean   @default(true) @map("is_active")
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  tier            CustomerTier?      @relation(fields: [tierId], references: [id], onDelete: SetNull)
  preferredBranch Branch?            @relation(fields: [preferredBranchId], references: [id], onDelete: SetNull)
  transactions    SalesTransaction[]
  serviceOrders   ServiceOrder[]

  @@index([customerCode])
  @@index([email])
  @@index([phone])
  @@index([tierId])
  @@index([customerType])
  @@index([isActive])
  @@index([isBlacklisted])
  @@index([deletedAt])
  @@map("customers")
}

// ============================================
// 5. SALES & TRANSACTIONS
// ============================================

model SalesTransaction {
  id                String   @id @default(uuid())
  transactionNumber String   @unique @map("transaction_number") // TRX-YYYYMMDD-XXXXXX
  transactionType   String   @map("transaction_type") // 'pos', 'order', 'pre-order'
  branchId          String   @map("branch_id")
  customerId        String?  @map("customer_id")
  cashierId         String   @map("cashier_id") // User ID
  status            String   @default("pending") // 'pending', 'completed', 'cancelled', 'void', 'held'
  subtotal          Decimal  @db.Decimal(15, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  taxPercentage     Decimal  @default(11) @map("tax_percentage") @db.Decimal(5, 2)
  total             Decimal  @db.Decimal(15, 2)
  paymentStatus     String   @default("pending") @map("payment_status") // 'pending', 'partial', 'paid', 'refunded'
  notes             String?  @db.Text
  receiptUrl        String?  @map("receipt_url")
  voidReason        String?  @map("void_reason")
  voidedAt          DateTime? @map("voided_at")
  voidedBy          String?  @map("voided_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier   User       @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items     SalesTransactionItem[]
  payments  Payment[]
  stockMovements StockMovement[]

  @@index([transactionNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([cashierId])
  @@index([status])
  @@index([transactionType])
  @@index([createdAt])
  @@map("sales_transactions")
}

model SalesTransactionItem {
  id                String   @id @default(uuid())
  transactionId     String   @map("transaction_id")
  productId         String   @map("product_id")
  productName       String   @map("product_name") // Snapshot at time of sale
  productSku        String   @map("product_sku") // Snapshot
  quantity          Decimal  @db.Decimal(15, 3)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(15, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  subtotal          Decimal  @db.Decimal(15, 2)
  batchNumber       String?  @map("batch_number")
  serialNumber      String?  @map("serial_number")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  transaction SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([productId])
  @@map("sales_transaction_items")
}

model Payment {
  id                String   @id @default(uuid())
  transactionId     String?  @map("transaction_id") // Nullable for other payment types
  paymentMethod     String   @map("payment_method") // 'cash', 'card', 'transfer', 'e-wallet', 'credit'
  amount            Decimal  @db.Decimal(15, 2)
  paymentDetails    Json?    @map("payment_details") // JSONB: {cardLast4, transferRef, etc}
  receiptUrl        String?  @map("receipt_url")
  status            String   @default("pending") // 'pending', 'completed', 'failed', 'refunded'
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  transaction SalesTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([paymentMethod])
  @@index([status])
  @@map("payments")
}

model StockMovement {
  id                String   @id @default(uuid())
  productId         String   @map("product_id")
  branchId          String   @map("branch_id")
  movementType      String   @map("movement_type") // 'IN', 'OUT', 'TRANSFER', 'ADJUSTMENT'
  referenceType     String   @map("reference_type") // 'SALE', 'PURCHASE', 'TRANSFER', 'OPNAME', etc
  referenceId       String?  @map("reference_id") // Transaction ID, Transfer ID, etc
  quantityChange    Decimal  @map("quantity_change") @db.Decimal(15, 3) // Positive for IN, negative for OUT
  quantityBefore    Decimal  @map("quantity_before") @db.Decimal(15, 3)
  quantityAfter     Decimal  @map("quantity_after") @db.Decimal(15, 3)
  batchNumber       String?  @map("batch_number")
  serialNumber      String?  @map("serial_number")
  notes             String?  @db.Text
  createdBy         String   @map("created_by") // User ID
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  transaction SalesTransaction? @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([branchId])
  @@index([movementType])
  @@index([referenceType])
  @@index([referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

model HeldTransaction {
  id                String   @id @default(uuid())
  reference         String?  @unique // User-provided reference
  transactionData   Json     @map("transaction_data") // JSONB: Full transaction data
  branchId          String   @map("branch_id")
  cashierId         String   @map("cashier_id")
  expiresAt         DateTime @map("expires_at") // Auto-release after 24 hours
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  branch  Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier User   @relation(fields: [cashierId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([cashierId])
  @@index([expiresAt])
  @@map("held_transactions")
}

// ============================================
// Placeholder for Employee (will be expanded in later phases)
// ============================================

model Employee {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("employees")
}

// ============================================
// 6. INVENTORY & STOCK MANAGEMENT
// ============================================

model StockTransfer {
  id            String   @id @default(uuid())
  transferNumber String  @unique @map("transfer_number") // TRF-YYYYMMDD-XXXXXX
  fromBranchId   String   @map("from_branch_id")
  toBranchId     String   @map("to_branch_id")
  transferType   String   @map("transfer_type") // 'regular', 'urgent'
  status         String   @default("pending") // 'pending', 'approved', 'sent', 'received', 'cancelled'
  requestedBy   String   @map("requested_by") // User ID
  approvedBy     String?  @map("approved_by") // User ID
  sentBy          String?  @map("sent_by") // User ID
  receivedBy     String?  @map("received_by") // User ID
  sentAt          DateTime? @map("sent_at")
  receivedAt      DateTime? @map("received_at")
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  fromBranch Branch            @relation("StockTransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch            @relation("StockTransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  items      StockTransferItem[]

  @@index([transferNumber])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([transferType])
  @@index([createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                String   @id @default(uuid())
  transferId        String   @map("transfer_id")
  productId         String   @map("product_id")
  quantityRequested Decimal  @map("quantity_requested") @db.Decimal(15, 3)
  quantitySent      Decimal? @map("quantity_sent") @db.Decimal(15, 3)
  quantityReceived  Decimal? @map("quantity_received") @db.Decimal(15, 3)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model StockOpname {
  id              String   @id @default(uuid())
  opnameNumber    String   @unique @map("opname_number") // OP-YYYYMMDD-XXXXXX
  branchId        String   @map("branch_id")
  opnameDate      DateTime @map("opname_date")
  status          String   @default("draft") // 'draft', 'counting', 'completed', 'approved'
  startedBy       String   @map("started_by") // User ID
  completedBy     String?  @map("completed_by") // User ID
  approvedBy      String?  @map("approved_by") // User ID
  totalDiscrepancyValue Decimal? @map("total_discrepancy_value") @db.Decimal(15, 2)
  notes           String?  @db.Text
  completedAt     DateTime? @map("completed_at")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  branch Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items  StockOpnameItem[]

  @@index([opnameNumber])
  @@index([branchId])
  @@index([status])
  @@index([opnameDate])
  @@index([createdAt])
  @@map("stock_opname")
}

model StockOpnameItem {
  id                String   @id @default(uuid())
  opnameId          String   @map("opname_id")
  productId         String   @map("product_id")
  systemQuantity    Decimal  @map("system_quantity") @db.Decimal(15, 3) // From product_stock
  physicalQuantity  Decimal? @map("physical_quantity") @db.Decimal(15, 3) // Counted quantity
  discrepancy       Decimal? @db.Decimal(15, 3) // physical - system
  discrepancyValue  Decimal? @map("discrepancy_value") @db.Decimal(15, 2) // discrepancy * cost_price
  condition         String?  // 'good', 'damaged', 'expired'
  notes             String?  @db.Text
  countedBy         String?  @map("counted_by") // User ID
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  opname StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([opnameId])
  @@index([productId])
  @@map("stock_opname_items")
}

// ============================================
// 7. SERVICE MANAGEMENT
// ============================================

model ServiceType {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  description     String?  @db.Text
  basePrice       Decimal  @map("base_price") @db.Decimal(15, 2)
  minPrice        Decimal? @map("min_price") @db.Decimal(15, 2)
  maxPrice        Decimal? @map("max_price") @db.Decimal(15, 2)
  slaHours        Int      @map("sla_hours") // Base SLA in hours
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  serviceOrders ServiceOrder[]

  @@index([code])
  @@index([isActive])
  @@map("service_types")
}

model ServiceOrder {
  id                    String   @id @default(uuid())
  serviceNumber         String   @unique @map("service_number") // SRV-YYYYMMDD-XXXXXX
  internalNumber        String?  @unique @map("internal_number") // INT-XXXXXX
  branchId              String   @map("branch_id")
  customerId            String?  @map("customer_id") // Nullable for walk-in
  serviceTypeId         String?  @map("service_type_id")
  assignedTechnicianId  String?  @map("assigned_technician_id")
  
  // Customer info (snapshot or walk-in)
  customerName          String   @map("customer_name")
  customerPhone         String   @map("customer_phone")
  customerEmail         String?  @map("customer_email")
  customerAlternatePhone String? @map("customer_alternate_phone")
  
  // Device info
  deviceType            String   @map("device_type") // 'handphone', 'laptop', 'tablet', 'other'
  deviceBrand           String?  @map("device_brand")
  deviceModel           String?  @map("device_model")
  deviceSerial          String?  @map("device_serial")
  deviceImei            String?  @map("device_imei")
  devicePassword        String?  @map("device_password") // Encrypted
  deviceCondition       String?  @map("device_condition")
  accessoriesIncluded   Json?    @map("accessories_included") // JSONB array
  
  // Service details
  complaint             String   @db.Text
  initialDiagnosis      String?  @map("initial_diagnosis") @db.Text
  diagnosis             String?  @db.Text
  workNotes             String?  @map("work_notes") @db.Text
  
  // Pricing
  estimatedCost         Decimal? @map("estimated_cost") @db.Decimal(15, 2)
  quotedPrice           Decimal? @map("quoted_price") @db.Decimal(15, 2)
  customerApprovedPrice Decimal? @map("customer_approved_price") @db.Decimal(15, 2)
  laborCost             Decimal? @map("labor_cost") @db.Decimal(15, 2)
  partsCost             Decimal  @default(0) @map("parts_cost") @db.Decimal(15, 2)
  otherCost             Decimal? @map("other_cost") @db.Decimal(15, 2)
  finalPrice            Decimal? @map("final_price") @db.Decimal(15, 2)
  taxAmount             Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalPrice            Decimal? @map("total_price") @db.Decimal(15, 2)
  
  // Status & workflow
  status                String   @default("pending") // 'pending', 'diagnosed', 'quoted', 'approved', 'in-progress', 'qc', 'completed', 'delivered', 'cancelled'
  priority              String   @default("normal") // 'normal', 'urgent'
  qualityStatus         String?  @map("quality_status") // 'pass', 'fail', null
  isOverdue             Boolean  @default(false) @map("is_overdue")
  
  // Dates
  receivedDate          DateTime @map("received_date")
  promisedDate          DateTime? @map("promised_date")
  slaDueDate            DateTime? @map("sla_due_date")
  assignedAt            DateTime? @map("assigned_at")
  diagnosedAt           DateTime? @map("diagnosed_at")
  quotedAt              DateTime? @map("quoted_at")
  approvedAt            DateTime? @map("approved_at")
  startedAt             DateTime? @map("started_at")
  completedAt           DateTime? @map("completed_at")
  deliveredAt           DateTime? @map("delivered_at")
  cancelledAt           DateTime? @map("cancelled_at")
  
  // Warranty
  warrantyDays          Int      @default(30) @map("warranty_days")
  warrantyExpiryDate    DateTime? @map("warranty_expiry_date")
  
  // Payment
  paymentStatus         String   @default("pending") @map("payment_status") // 'pending', 'partial', 'paid'
  paymentMethod         String?  @map("payment_method")
  paidAt                DateTime? @map("paid_at")
  
  // Feedback
  customerRating        Int?     @map("customer_rating") // 1-5
  customerFeedback      String?  @map("customer_feedback") @db.Text
  feedbackDate          DateTime? @map("feedback_date")
  
  // Notes
  customerNotes         String?  @map("customer_notes") @db.Text
  internalNotes         String?   @map("internal_notes") @db.Text
  cancellationReason   String?  @map("cancellation_reason") @db.Text
  
  // Created by
  createdBy             String   @map("created_by") // User ID
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  branch                Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer              Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceType           ServiceType?           @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  assignedTechnician    User?                  @relation("ServiceTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  statusHistory         ServiceStatusHistory[]
  partsUsed             ServicePartsUsed[]
  photos                ServicePhoto[]

  @@index([serviceNumber])
  @@index([internalNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([assignedTechnicianId])
  @@index([status])
  @@index([priority])
  @@index([receivedDate])
  @@index([slaDueDate])
  @@index([isOverdue])
  @@map("service_orders")
}

model ServiceStatusHistory {
  id            String   @id @default(uuid())
  serviceOrderId String  @map("service_order_id")
  status        String
  previousStatus String? @map("previous_status")
  notes         String?  @db.Text
  changedBy     String   @map("changed_by") // User ID
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([status])
  @@index([createdAt])
  @@map("service_status_history")
}

model ServicePartsUsed {
  id            String   @id @default(uuid())
  serviceOrderId String  @map("service_order_id")
  productId     String   @map("product_id")
  quantity      Decimal  @db.Decimal(15, 3)
  unitCost     Decimal  @map("unit_cost") @db.Decimal(15, 2)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(15, 2) // Price charged to customer
  totalCost     Decimal  @map("total_cost") @db.Decimal(15, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(15, 2)
  batchNumber   String?  @map("batch_number")
  serialNumber  String?  @map("serial_number")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([serviceOrderId])
  @@index([productId])
  @@map("service_parts_used")
}

model ServicePhoto {
  id            String   @id @default(uuid())
  serviceOrderId String  @map("service_order_id")
  photoUrl     String   @map("photo_url")
  photoType    String   @map("photo_type") // 'intake', 'diagnosis', 'repair', 'completed'
  description  String?  @db.Text
  uploadedBy   String   @map("uploaded_by") // User ID
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([photoType])
  @@map("service_photos")
}
