// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. AUTHENTICATION & USERS
// ============================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  username            String?   @unique
  passwordHash        String    @map("password_hash")
  fullName            String?   @map("full_name")
  phone               String?
  profilePhotoUrl     String?   @map("profile_photo_url")
  isActive            Boolean   @default(true) @map("is_active")
  isVerified          Boolean   @default(false) @map("is_verified")
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?   @map("two_factor_secret")
  canChangePassword   Boolean   @default(true) @map("can_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  banReason           String?   @map("ban_reason")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  // Relations
  userRoles              UserRole[]
  employee               Employee?
  cashierTransactions    SalesTransaction[]
  heldTransactions       HeldTransaction[]
  assignedServices       ServiceOrder[]          @relation("ServiceTechnician")
  statusHistoryChanges   ServiceStatusHistory[]  @relation("ServiceStatusHistoryChangedBy")
  branchHeadOfService    Branch[]                @relation("BranchHeadOfService")
  passwordChangeRequests PasswordChangeRequest[]

  @@index([email])
  @@index([username])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model PasswordChangeRequest {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  currentPassword String    @map("current_password")
  newPasswordHash String    @map("new_password_hash")
  status          String    @default("pending") // pending, approved, rejected
  requestedAt     DateTime  @default(now()) @map("requested_at")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
  @@map("password_change_requests")
}

model Role {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  description        String?
  level              Int // Hierarchical level (0=SUPERADMIN, 1=OWNER, etc.)
  defaultPermissions String[] @default([]) @map("default_permissions") // Built-in permission keys for this role
  isSystemRole       Boolean  @default(false) @map("is_system_role")
  isActive           Boolean  @default(true) @map("is_active")
  parentRoleId       String?  @map("parent_role_id") // For role hierarchy
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  roleMenuAccess  RoleMenuAccess[]
  parentRole      Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles      Role[]           @relation("RoleHierarchy")

  @@index([code])
  @@index([level])
  @@index([isActive])
  @@index([parentRoleId])
  @@map("roles")
}

model UserRole {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  roleId            String    @map("role_id")
  branchId          String?   @map("branch_id") // null = all branches
  isPrimary         Boolean   @default(false) @map("is_primary")
  deniedPermissions String[]  @default([]) @map("denied_permissions") // Subtractive permissions for this assignment
  validFrom         DateTime  @default(now()) @map("valid_from")
  validUntil        DateTime? @map("valid_until") // null = no expiration
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([roleId])
  @@index([branchId])
  @@index([isPrimary])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String // e.g., "inventory", "sales", "service"
  submodule   String? // e.g., "stock_transfer", "pos", "repair"
  action      String // e.g., "view", "create", "edit", "delete", "approve", "export"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@unique([module, submodule, action])
  @@index([module])
  @@index([submodule])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id               String   @id @default(uuid())
  roleId           String   @map("role_id")
  permissionId     String   @map("permission_id")
  maxAmount        Decimal? @map("max_amount") @db.Decimal(15, 2) // For amount-based permissions
  requiresApproval Boolean  @default(false) @map("requires_approval")
  conditions       Json? // JSONB for flexible conditions (e.g., {"approverRoles": ["HS", "SPV"]})
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RoleMenuAccess {
  id        String   @id @default(uuid())
  roleId    String   @map("role_id")
  menuKey   String   @map("menu_key") // e.g., "dashboard", "master_data", "master_data.products"
  menuPath  String?  @map("menu_path") // e.g., "/dashboard", "/products"
  menuLabel String   @map("menu_label") // e.g., "Dashboard", "Master Data", "Products"
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuKey])
  @@index([roleId])
  @@index([menuKey])
  @@map("role_menu_access")
}

// ============================================
// 2. ORGANIZATION
// ============================================

model Branch {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  type            String // e.g., "store", "warehouse", "office"
  phone           String?
  email           String?
  address         String?
  city            String?
  province        String?
  headOfServiceId String?  @map("head_of_service_id") // HS (Head of Store) responsible for this branch
  isActive        Boolean  @default(true) @map("is_active")
  isWarehouse     Boolean  @default(false) @map("is_warehouse") // Warehouse capability flag
  operatingHours  Json?    @map("operating_hours") // JSONB: {"monday": {"open": "08:00", "close": "22:00"}, ...}
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  headOfService      User?              @relation("BranchHeadOfService", fields: [headOfServiceId], references: [id], onDelete: SetNull)
  userRoles          UserRole[]
  departments        Department[]
  productStocks      ProductStock[]
  preferredCustomers Customer[]
  salesTransactions  SalesTransaction[]
  stockMovements     StockMovement[]
  heldTransactions   HeldTransaction[]
  stockTransfersFrom StockTransfer[]    @relation("StockTransferFrom")
  stockTransfersTo   StockTransfer[]    @relation("StockTransferTo")
  stockOpnames       StockOpname[]
  serviceOrders      ServiceOrder[]
  journalEntryLines  JournalEntryLine[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]     @relation("GoodsReceiptBranch")
  expenses           Expense[]
  pettyCash          PettyCash[]
  employees          Employee[]
  attendances        Attendance[]

  @@index([code])
  @@index([isActive])
  @@index([headOfServiceId])
  @@map("branches")
}

model Department {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  parentDepartmentId String?  @map("parent_department_id") // For hierarchical structure
  branchId           String?  @map("branch_id") // null = company-wide department
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  parentDepartment  Department?        @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments  Department[]       @relation("DepartmentHierarchy")
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  journalEntryLines JournalEntryLine[]
  expenses          Expense[]
  employees         Employee[]

  @@index([code])
  @@index([parentDepartmentId])
  @@index([branchId])
  @@index([isActive])
  @@map("departments")
}

// ============================================
// 3. PRODUCTS & INVENTORY
// ============================================

model Category {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  parentCategoryId String?  @map("parent_category_id") // For hierarchical categories
  description      String?
  isActive         Boolean  @default(true) @map("is_active")
  tierMargins      Json?    @map("tier_margins")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  parentCategory      Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories     Category[] @relation("CategoryHierarchy")
  products            Product[]
  subCategoryProducts Product[]  @relation("ProductSubCategory")

  @@index([code])
  @@index([parentCategoryId])
  @@index([isActive])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  logoUrl     String?  @map("logo_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  products Product[]

  @@index([code])
  @@index([isActive])
  @@map("brands")
}


model Color {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  products Product[] @relation("ProductColor")

  @@index([code])
  @@index([isActive])
  @@map("colors")
}

model Unit {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  products Product[] @relation("ProductUnit")

  @@index([code])
  @@index([isActive])
  @@map("units")
}

model Size {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  products Product[] @relation("ProductSize")

  @@index([code])
  @@index([isActive])
  @@map("sizes")
}

model Expedition {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  @@index([code])
  @@index([isActive])
  @@map("expeditions")
}

model SalesType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  @@index([code])
  @@index([isActive])
  @@map("sales_types")
}

model PaymentTerm {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  days      Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customers Customer[]

  @@index([code])
  @@index([isActive])
  @@map("payment_terms")
}

model Product {
  id                    String    @id @default(uuid())
  barcode               String?   @unique
  sku                   String    @unique
  name                  String
  printedName           String?   @map("printed_name") // Nama Tercetak
  categoryId            String    @map("category_id")
  subCategoryId         String?   @map("sub_category_id") // Sub Kategori
  brandId               String?   @map("brand_id")
  supplierId            String?   @map("supplier_id") // Supplier (relation ke Customer dengan customerType='wholesale')
  costPrice             Decimal   @map("cost_price") @db.Decimal(15, 2)
  sellingPrice          Decimal   @map("selling_price") @db.Decimal(15, 2)
  minSellingPrice       Decimal?  @map("min_selling_price") @db.Decimal(15, 2) // Harga Jual Minimum
  unitId                String?   @map("unit_id") // Relasi ke Unit
  sizeId                String?   @map("size_id") // Relasi ke Size
  colorId               String?   @map("color_id") // Relasi ke Color
  lengthCm              Decimal?  @map("length_cm") @db.Decimal(10, 2) // Panjang(cm)
  widthCm               Decimal?  @map("width_cm") @db.Decimal(10, 2) // Lebar(cm)
  heightCm              Decimal?  @map("height_cm") @db.Decimal(10, 2) // Tinggi(cm)
  weightGrams           Decimal?  @map("weight_grams") @db.Decimal(10, 2) // Berat Barang (gram)
  packageWeightGrams    Decimal?  @map("package_weight_grams") @db.Decimal(10, 2) // Berat Paket (gram)
  isActive              Boolean   @default(true) @map("is_active")
  isService             Boolean   @default(false) @map("is_service") // Jasa(Y/N)
  trackSerial           Boolean   @default(false) @map("track_serial") // Track by serial number (SN(1)/Bahan(2))
  trackBatch            Boolean   @default(false) @map("track_batch") // Track by batch number
  trackExpiry           Boolean   @default(false) @map("track_expiry") // Menggunakan Tgl Kadaluarsa(Y/N)
  expiryReturnLimitDays Int?      @map("expiry_return_limit_days") // Batas Retur Kadaluarsa (hari)
  memberPricing         Json?     @map("member_pricing") // JSONB: {"platinum": {"discount": 10}, "gold": {"discount": 5}, ...}
  images                Json? // JSONB array: ["url1", "url2", ...]
  description           String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  // Relations
  category           Category               @relation(fields: [categoryId], references: [id])
  subCategory        Category?              @relation("ProductSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull)
  brand              Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  color              Color?                 @relation("ProductColor", fields: [colorId], references: [id], onDelete: SetNull)
  unit               Unit?                  @relation("ProductUnit", fields: [unitId], references: [id], onDelete: SetNull)
  size               Size?                  @relation("ProductSize", fields: [sizeId], references: [id], onDelete: SetNull)
  supplier           Customer?              @relation("ProductSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  productStocks      ProductStock[]
  transactionItems   SalesTransactionItem[]
  stockMovements     StockMovement[]
  transferItems      StockTransferItem[]
  opnameItems        StockOpnameItem[]
  servicePartsUsed   ServicePartsUsed[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]     @relation("GoodsReceiptItemProduct")

  @@index([barcode])
  @@index([sku])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([supplierId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("products")
}

model ProductStock {
  id                String   @id @default(uuid())
  productId         String   @map("product_id")
  branchId          String   @map("branch_id")
  quantityAvailable Decimal  @default(0) @map("quantity_available") @db.Decimal(15, 3)
  quantityReserved  Decimal  @default(0) @map("quantity_reserved") @db.Decimal(15, 3)
  quantityDamaged   Decimal  @default(0) @map("quantity_damaged") @db.Decimal(15, 3)
  minStock          Decimal? @map("min_stock") @db.Decimal(15, 3)
  maxStock          Decimal? @map("max_stock") @db.Decimal(15, 3)
  reorderPoint      Decimal? @map("reorder_point") @db.Decimal(15, 3)
  branchPrice       Decimal? @map("branch_price") @db.Decimal(15, 2) // Branch-specific pricing override
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
  @@index([reorderPoint])
  @@map("product_stock")
}

// ============================================
// 4. CUSTOMERS
// ============================================

model CustomerTier {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  description        String?
  level              Int      @default(0) // Ordering/priority level
  discountPercentage Decimal  @map("discount_percentage") @db.Decimal(5, 2) // e.g., 15.00 for 15%
  creditLimit        Decimal  @map("credit_limit") @db.Decimal(15, 2)
  minPurchaseAmount  Decimal? @map("min_purchase_amount") @db.Decimal(15, 2) // Minimum purchase to qualify
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  customers Customer[]

  @@index([code])
  @@index([isActive])
  @@map("customer_tiers")
}

model Customer {
  id                   String    @id @default(uuid())
  customerCode         String    @unique @map("customer_code")
  customerType         String    @map("customer_type") // 'retail', 'wholesale', 'corporate'
  tierId               String?   @map("tier_id")
  name                 String
  email                String?
  phone                String
  alternatePhone       String?   @map("alternate_phone") // No HP (untuk import/export)
  dateOfBirth          DateTime? @map("date_of_birth")
  gender               String? // 'L', 'P'
  address              String?
  subdistrict          String?   @map("subdistrict") // Kecamatan
  city                 String?
  province             String?
  postalCode           String?   @map("postal_code")
  country              String?   @default("Indonesia")
  religion             String? // Agama
  idType               String?   @map("id_type") // Jenis Identitas (KTP, SIM, dll)
  idNumber             String?   @map("id_number") // Nomor Identitas
  taxId                String?   @map("tax_id") // No NPWP/KTP
  taxName              String?   @map("tax_name") // Nama (Pajak)
  taxIdType            String?   @map("tax_id_type") // Jenis Identitas Pajak (NPWP/KTP)
  taxAddress           String?   @map("tax_address") // Alamat (Pajak)
  idTKU                String?   @map("id_tku") // IDTKU
  taxTransactionDetail String?   @map("tax_transaction_detail") // Detail Transaksi Pajak (01/02/03..dst)
  creditLimit          Decimal   @default(0) @map("credit_limit") @db.Decimal(15, 2) // Plafon Nilai
  creditLimitNoteCount Int?      @map("credit_limit_note_count") // Plafon Jumlah Nota
  creditUsed           Decimal   @default(0) @map("credit_used") @db.Decimal(15, 2)
  paymentTermId        String?   @map("payment_term_id")
  paymentTermDays      Int?      @map("payment_term_days")
  preferredBranchId    String?   @map("preferred_branch_id")
  depositBalance       Decimal   @default(0) @map("deposit_balance") @db.Decimal(15, 2)
  isBlacklisted        Boolean   @default(false) @map("is_blacklisted")
  blacklistReason      String?   @map("blacklist_reason")
  blacklistUntil       DateTime? @map("blacklist_until")
  isActive             Boolean   @default(true) @map("is_active")
  notes                String?   @db.Text // Keterangan
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  // Relations
  tier             CustomerTier?      @relation(fields: [tierId], references: [id], onDelete: SetNull)
  preferredBranch  Branch?            @relation(fields: [preferredBranchId], references: [id], onDelete: SetNull)
  paymentTerm      PaymentTerm?       @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  transactions     SalesTransaction[]
  serviceOrders    ServiceOrder[]
  arPayments       ARPayment[]
  writeOffs        WriteOff[]
  supplierProducts Product[]          @relation("ProductSupplier")
  purchaseOrders   PurchaseOrder[]    @relation("PurchaseOrderSupplier")
  customerDeposits CustomerDeposit[]

  @@index([customerCode])
  @@index([email])
  @@index([phone])
  @@index([tierId])
  @@index([customerType])
  @@index([isActive])
  @@index([isBlacklisted])
  @@index([deletedAt])
  @@map("customers")
}

// ============================================
// 5. SALES & TRANSACTIONS
// ============================================

model SalesTransaction {
  id                 String    @id @default(uuid())
  transactionNumber  String    @unique @map("transaction_number") // TRX-YYYYMMDD-XXXXXX
  transactionType    String    @map("transaction_type") // 'pos', 'order', 'pre-order'
  branchId           String    @map("branch_id")
  customerId         String?   @map("customer_id")
  cashierId          String    @map("cashier_id") // User ID
  paymentTermId      String?   @map("payment_term_id")
  salesPersonId      String?   @map("sales_person_id")
  warehouseId        String?   @map("warehouse_id")
  salesTypeId        String?   @map("sales_type_id") // T21: plain ref to sales_types (no FK until Workstream D)
  status             String    @default("pending") // 'pending', 'completed', 'cancelled', 'void', 'held'
  subtotal           Decimal   @db.Decimal(15, 2)
  discountAmount     Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  discountPercentage Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  taxAmount          Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  taxPercentage      Decimal   @default(11) @map("tax_percentage") @db.Decimal(5, 2)
  total              Decimal   @db.Decimal(15, 2)
  paymentStatus      String    @default("pending") @map("payment_status") // 'pending', 'partial', 'paid', 'refunded'
  receiptNotes       String?   @map("receipt_notes") @db.Text
  internalNotes      String?   @map("internal_notes") @db.Text
  receiptUrl         String?   @map("receipt_url")
  voidReason         String?   @map("void_reason")
  voidedAt           DateTime? @map("voided_at")
  voidedBy           String?   @map("voided_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  branch         Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier        User                   @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items          SalesTransactionItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([transactionNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([cashierId])
  @@index([status])
  @@index([transactionType])
  @@index([createdAt])
  @@map("sales_transactions")
}

model SalesTransactionItem {
  id                 String   @id @default(uuid())
  transactionId      String   @map("transaction_id")
  productId          String   @map("product_id")
  productName        String   @map("product_name") // Snapshot at time of sale
  productSku         String   @map("product_sku") // Snapshot
  quantity           Decimal  @db.Decimal(15, 3)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(15, 2)
  discountAmount     Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  subtotal           Decimal  @db.Decimal(15, 2)
  batchNumber        String?  @map("batch_number")
  serialNumber       String?  @map("serial_number")
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  transaction SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([productId])
  @@map("sales_transaction_items")
}

model Payment {
  id             String    @id @default(uuid())
  transactionId  String?   @map("transaction_id") // Nullable for other payment types
  paymentMethod  String    @map("payment_method") // 'cash', 'card', 'transfer', 'e-wallet', 'credit'
  amount         Decimal   @db.Decimal(15, 2)
  paymentDetails Json?     @map("payment_details") // JSONB: {cardLast4, transferRef, etc}
  receiptUrl     String?   @map("receipt_url")
  status         String    @default("pending") // 'pending', 'completed', 'failed', 'refunded'
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  transaction SalesTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([paymentMethod])
  @@index([status])
  @@map("payments")
}

model StockMovement {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  branchId       String   @map("branch_id")
  movementType   String   @map("movement_type") // 'IN', 'OUT', 'TRANSFER', 'ADJUSTMENT'
  referenceType  String   @map("reference_type") // 'SALE', 'PURCHASE', 'TRANSFER', 'OPNAME', etc
  referenceId    String?  @map("reference_id") // Transaction ID, Transfer ID, etc
  quantityChange Decimal  @map("quantity_change") @db.Decimal(15, 3) // Positive for IN, negative for OUT
  quantityBefore Decimal  @map("quantity_before") @db.Decimal(15, 3)
  quantityAfter  Decimal  @map("quantity_after") @db.Decimal(15, 3)
  batchNumber    String?  @map("batch_number")
  serialNumber   String?  @map("serial_number")
  notes          String?  @db.Text
  createdBy      String   @map("created_by") // User ID
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  transaction SalesTransaction? @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([branchId])
  @@index([movementType])
  @@index([referenceType])
  @@index([referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

model HeldTransaction {
  id              String   @id @default(uuid())
  reference       String?  @unique // User-provided reference
  transactionData Json     @map("transaction_data") // JSONB: Full transaction data
  branchId        String   @map("branch_id")
  cashierId       String   @map("cashier_id")
  expiresAt       DateTime @map("expires_at") // Auto-release after 24 hours
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  branch  Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier User   @relation(fields: [cashierId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([cashierId])
  @@index([expiresAt])
  @@map("held_transactions")
}

// ============================================
// Placeholder for Employee (will be expanded in later phases)
// ============================================

model Employee {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  employeeCode   String    @unique @map("employee_code") // EMP-XXXX
  branchId       String?   @map("branch_id")
  departmentId   String?   @map("department_id")
  position       String? // Job title
  hireDate       DateTime? @map("hire_date")
  employmentType String?   @map("employment_type") // 'full-time', 'part-time', 'contract'
  basicSalary    Decimal?  @map("basic_salary") @db.Decimal(15, 2)
  hourlyRate     Decimal?  @map("hourly_rate") @db.Decimal(15, 2)
  bankAccount    String?   @map("bank_account")
  bankName       String?   @map("bank_name")
  taxId          String?   @map("tax_id") // NPWP
  bpjsNumber     String?   @map("bpjs_number")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  payrolls         Payroll[]
  kpiRecords       KPIRecord[]

  @@index([userId])
  @@index([employeeCode])
  @@index([branchId])
  @@index([departmentId])
  @@index([isActive])
  @@map("employees")
}

// ============================================
// 6. INVENTORY & STOCK MANAGEMENT
// ============================================

model StockTransfer {
  id             String    @id @default(uuid())
  transferNumber String    @unique @map("transfer_number") // TRF-YYYYMMDD-XXXXXX
  fromBranchId   String    @map("from_branch_id")
  toBranchId     String    @map("to_branch_id")
  transferType   String    @map("transfer_type") // 'regular', 'urgent'
  status         String    @default("pending") // 'pending', 'approved', 'sent', 'received', 'cancelled'
  requestedBy    String    @map("requested_by") // User ID
  approvedBy     String?   @map("approved_by") // User ID
  sentBy         String?   @map("sent_by") // User ID
  receivedBy     String?   @map("received_by") // User ID
  sentAt         DateTime? @map("sent_at")
  receivedAt     DateTime? @map("received_at")
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  fromBranch Branch              @relation("StockTransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch              @relation("StockTransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  items      StockTransferItem[]

  @@index([transferNumber])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([transferType])
  @@index([createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                String   @id @default(uuid())
  transferId        String   @map("transfer_id")
  productId         String   @map("product_id")
  quantityRequested Decimal  @map("quantity_requested") @db.Decimal(15, 3)
  quantitySent      Decimal? @map("quantity_sent") @db.Decimal(15, 3)
  quantityReceived  Decimal? @map("quantity_received") @db.Decimal(15, 3)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model StockOpname {
  id                    String    @id @default(uuid())
  opnameNumber          String    @unique @map("opname_number") // OP-YYYYMMDD-XXXXXX
  branchId              String    @map("branch_id")
  opnameDate            DateTime  @map("opname_date")
  status                String    @default("draft") // 'draft', 'counting', 'completed', 'approved'
  startedBy             String    @map("started_by") // User ID
  completedBy           String?   @map("completed_by") // User ID
  approvedBy            String?   @map("approved_by") // User ID
  totalDiscrepancyValue Decimal?  @map("total_discrepancy_value") @db.Decimal(15, 2)
  notes                 String?   @db.Text
  completedAt           DateTime? @map("completed_at")
  approvedAt            DateTime? @map("approved_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  branch Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items  StockOpnameItem[]

  @@index([opnameNumber])
  @@index([branchId])
  @@index([status])
  @@index([opnameDate])
  @@index([createdAt])
  @@map("stock_opname")
}

model StockOpnameItem {
  id               String   @id @default(uuid())
  opnameId         String   @map("opname_id")
  productId        String   @map("product_id")
  systemQuantity   Decimal  @map("system_quantity") @db.Decimal(15, 3) // From product_stock
  physicalQuantity Decimal? @map("physical_quantity") @db.Decimal(15, 3) // Counted quantity
  discrepancy      Decimal? @db.Decimal(15, 3) // physical - system
  discrepancyValue Decimal? @map("discrepancy_value") @db.Decimal(15, 2) // discrepancy * cost_price
  condition        String? // 'good', 'damaged', 'expired'
  notes            String?  @db.Text
  countedBy        String?  @map("counted_by") // User ID
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  opname  StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([opnameId])
  @@index([productId])
  @@map("stock_opname_items")
}

// ============================================
// 7. SERVICE MANAGEMENT
// ============================================

model ServiceType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  basePrice   Decimal  @map("base_price") @db.Decimal(15, 2)
  minPrice    Decimal? @map("min_price") @db.Decimal(15, 2)
  maxPrice    Decimal? @map("max_price") @db.Decimal(15, 2)
  slaHours    Int      @map("sla_hours") // Base SLA in hours
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  serviceOrders ServiceOrder[]

  @@index([code])
  @@index([isActive])
  @@map("service_types")
}

model ServiceOrder {
  id                   String  @id @default(uuid())
  serviceNumber        String  @unique @map("service_number") // SRV-YYYYMMDD-XXXXXX
  internalNumber       String? @unique @map("internal_number") // INT-XXXXXX
  branchId             String  @map("branch_id")
  customerId           String? @map("customer_id") // Nullable for walk-in
  serviceTypeId        String? @map("service_type_id")
  assignedTechnicianId String? @map("assigned_technician_id")

  // Customer info (snapshot or walk-in)
  customerName           String  @map("customer_name")
  customerPhone          String  @map("customer_phone")
  customerEmail          String? @map("customer_email")
  customerSubdistrict  String? @map("customer_subdistrict")

  // Device info
  deviceType          String  @map("device_type") // 'handphone', 'laptop', 'tablet', 'other'
  deviceUnit          String? @map("device_unit") // e.g. 'Samsung A52' (replaces brand + model)
  deviceColor         String? @map("device_color")
  deviceSerial        String? @map("device_serial")
  deviceImei          String? @map("device_imei")
  devicePassword      String? @map("device_password") // Encrypted
  deviceCondition     String? @map("device_condition") @db.Text // textarea
  accessoriesIncluded Json?   @map("accessories_included") // JSONB array

  // Service details
  serviceSubType   String? @map("service_sub_type") // 'quick' or 'inap'
  complaint        String  @db.Text
  initialDiagnosis String? @map("initial_diagnosis") @db.Text
  diagnosis        String? @db.Text
  workNotes        String? @map("work_notes") @db.Text

  // Pricing
  estimatedCost         Decimal? @map("estimated_cost") @db.Decimal(15, 2)
  quotedPrice           Decimal? @map("quoted_price") @db.Decimal(15, 2)
  customerApprovedPrice Decimal? @map("customer_approved_price") @db.Decimal(15, 2)
  laborCost             Decimal? @map("labor_cost") @db.Decimal(15, 2)
  partsCost             Decimal  @default(0) @map("parts_cost") @db.Decimal(15, 2)
  otherCost             Decimal? @map("other_cost") @db.Decimal(15, 2)
  discountAmount        Decimal? @default(0) @map("discount_amount") @db.Decimal(15, 2)
  promoCode             String?  @map("promo_code")
  finalPrice            Decimal? @map("final_price") @db.Decimal(15, 2)
  taxAmount             Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalPrice            Decimal? @map("total_price") @db.Decimal(15, 2)

  // Status & workflow
  status        String  @default("pending") // 'pending', 'diagnosed', 'quoted', 'approved', 'in-progress', 'qc', 'completed', 'delivered', 'cancelled'
  priority      String  @default("normal") // 'normal', 'urgent'
  qualityStatus String? @map("quality_status") // 'pass', 'fail', null
  isOverdue     Boolean @default(false) @map("is_overdue")

  // Dates
  receivedDate DateTime  @map("received_date")
  promisedDate DateTime? @map("promised_date")
  slaDueDate   DateTime? @map("sla_due_date")
  assignedAt   DateTime? @map("assigned_at")
  diagnosedAt  DateTime? @map("diagnosed_at")
  quotedAt     DateTime? @map("quoted_at")
  approvedAt   DateTime? @map("approved_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  deliveredAt  DateTime? @map("delivered_at")
  cancelledAt  DateTime? @map("cancelled_at")

  // Warranty
  warrantyDays       Int       @default(30) @map("warranty_days")
  warrantyExpiryDate DateTime? @map("warranty_expiry_date")

  // Payment
  quotationNumber String?   @unique @map("quotation_number") // Q-SRV-YYYYMM-XXXXXX
  invoiceNumber   String?   @unique @map("invoice_number") // INV-SRV-YYYYMM-XXXXXX
  paymentStatus   String    @default("pending") @map("payment_status") // 'pending', 'partial', 'paid'
  paymentMethod   String?   @map("payment_method")
  paidAt          DateTime? @map("paid_at")

  // Feedback
  customerRating   Int?      @map("customer_rating") // 1-5
  customerFeedback String?   @map("customer_feedback") @db.Text
  feedbackDate     DateTime? @map("feedback_date")

  // Smart Repair extension (E-BE2)
  warehouseId       String?  @map("warehouse_id") // plain ref until Workstream D adds Warehouse model
  taxPpn            Boolean  @default(false) @map("tax_ppn")
  taxIncPpn         Boolean  @default(false) @map("tax_inc_ppn")
  taxPph22          Boolean  @default(false) @map("tax_pph22")
  taxPph23          Boolean  @default(false) @map("tax_pph23")
  downPayment       Decimal? @map("down_payment") @db.Decimal(15, 2)
  completenessItems Json?    @map("completeness_items") // JSONB: [{checkpointId, name, checked, conditionNote}]

  // Notes
  customerNotes      String? @map("customer_notes") @db.Text
  internalNotes      String? @map("internal_notes") @db.Text
  cancellationReason String? @map("cancellation_reason") @db.Text

  // Created by
  createdBy String   @map("created_by") // User ID
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  branch             Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer           Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceType        ServiceType?           @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  assignedTechnician User?                  @relation("ServiceTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  statusHistory      ServiceStatusHistory[]
  partsUsed          ServicePartsUsed[]
  photos             ServicePhoto[]
  serviceReturns     ServiceReturn[]        @relation("ServiceReturnOriginal")
  reServiceOrders    ServiceReturn[]        @relation("ServiceReturnReService")

  @@index([serviceNumber])
  @@index([internalNumber])
  @@index([quotationNumber])
  @@index([invoiceNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([assignedTechnicianId])
  @@index([status])
  @@index([priority])
  @@index([receivedDate])
  @@index([slaDueDate])
  @@index([isOverdue])
  @@map("service_orders")
}

// ============================================
// SERVICE CHECKPOINTS (Kelengkapan)
// ============================================

model ServiceCheckpoint {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("service_checkpoints")
}

model ServiceStatusHistory {
  id             String   @id @default(uuid())
  serviceOrderId String   @map("service_order_id")
  status         String
  previousStatus String?  @map("previous_status")
  notes          String?  @db.Text
  changedBy      String   @map("changed_by") // User ID
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  serviceOrder  ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  changedByUser User?        @relation("ServiceStatusHistoryChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([serviceOrderId])
  @@index([status])
  @@index([createdAt])
  @@map("service_status_history")
}

model ServicePartsUsed {
  id             String   @id @default(uuid())
  serviceOrderId String   @map("service_order_id")
  productId      String   @map("product_id")
  purchaseType   String   @default("internal") @map("purchase_type") // 'internal' (stok sendiri) or 'external' (beli di luar)
  quantity       Decimal  @db.Decimal(15, 3)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(15, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(15, 2) // Price charged to customer
  totalCost      Decimal  @map("total_cost") @db.Decimal(15, 2)
  totalPrice     Decimal  @map("total_price") @db.Decimal(15, 2)
  batchNumber    String?  @map("batch_number")
  serialNumber   String?  @map("serial_number")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([serviceOrderId])
  @@index([productId])
  @@map("service_parts_used")
}

model ServicePhoto {
  id             String   @id @default(uuid())
  serviceOrderId String   @map("service_order_id")
  photoUrl       String   @map("photo_url")
  photoType      String   @map("photo_type") // 'intake', 'diagnosis', 'repair', 'completed'
  description    String?  @db.Text
  uploadedBy     String   @map("uploaded_by") // User ID
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([photoType])
  @@map("service_photos")
}

model ServiceReturn {
  id             String @id @default(uuid())
  returnNumber   String @unique @map("return_number") // RET-SRV-YYYYMMDD-XXXXXX
  serviceOrderId String @map("service_order_id")

  // Return/Complaint Details
  returnType           String  @map("return_type") // 're-service', 'complaint', 'warranty', 'combination'
  returnReason         String  @map("return_reason") @db.Text
  customerComplaint    String? @map("customer_complaint") @db.Text
  isWithinWarranty     Boolean @default(false) @map("is_within_warranty")
  isWithinReturnPeriod Boolean @default(true) @map("is_within_return_period")

  status String @default("pending") // 'pending', 'investigating', 'approved', 'rejected', 'resolved'

  // Resolution
  resolution        String?  @db.Text
  resolutionType    String?  @map("resolution_type") // 're-service', 'refund', 'discount', 'replacement'
  newServiceOrderId String?  @map("new_service_order_id")
  refundAmount      Decimal? @map("refund_amount") @db.Decimal(15, 2)

  // Approval
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectedBy      String?   @map("rejected_by")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason") @db.Text

  // Dates
  returnedAt DateTime  @map("returned_at")
  resolvedAt DateTime? @map("resolved_at")

  // Created by
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  serviceOrder    ServiceOrder  @relation("ServiceReturnOriginal", fields: [serviceOrderId], references: [id], onDelete: Restrict)
  newServiceOrder ServiceOrder? @relation("ServiceReturnReService", fields: [newServiceOrderId], references: [id], onDelete: SetNull)

  @@index([serviceOrderId])
  @@index([status])
  @@index([returnType])
  @@index([returnNumber])
  @@map("service_returns")
}

// ============================================
// 8. FINANCE & ACCOUNTING
// ============================================

model ChartOfAccount {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., "10100", "40100"
  name        String
  accountType String   @map("account_type") // 'ASSET', 'LIABILITY', 'EQUITY', 'REVENUE', 'EXPENSE'
  parentId    String?  @map("parent_id")
  isHeader    Boolean  @default(false) @map("is_header") // Header account (no transactions)
  isActive    Boolean  @default(true) @map("is_active")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  parent       ChartOfAccount?    @relation("ChartOfAccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     ChartOfAccount[]   @relation("ChartOfAccountHierarchy")
  journalLines JournalEntryLine[]
  expenses     Expense[]
  arPayments   ARPayment[]

  @@index([code])
  @@index([accountType])
  @@index([parentId])
  @@index([isActive])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id              String    @id @default(uuid())
  entryNumber     String    @unique @map("entry_number") // JE-YYYYMMDD-XXXXXX
  entryDate       DateTime  @map("entry_date")
  entryType       String    @map("entry_type") // 'manual', 'auto'
  status          String    @default("draft") // 'draft', 'posted', 'reversed'
  description     String    @db.Text
  referenceType   String?   @map("reference_type") // 'sales', 'purchase', 'expense', etc.
  referenceId     String?   @map("reference_id")
  notes           String?   @db.Text
  postedAt        DateTime? @map("posted_at")
  postedBy        String?   @map("posted_by") // User ID
  reversedAt      DateTime? @map("reversed_at")
  reversedBy      String?   @map("reversed_by") // User ID
  reversalReason  String?   @map("reversal_reason") @db.Text
  originalEntryId String?   @unique @map("original_entry_id") // For reversal entries (one-to-one)
  createdBy       String    @map("created_by") // User ID
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  lines         JournalEntryLine[]
  originalEntry JournalEntry?      @relation("JournalEntryReversal", fields: [originalEntryId], references: [id], onDelete: SetNull)
  reversalEntry JournalEntry?      @relation("JournalEntryReversal")
  expenses      Expense[]
  arPayments    ARPayment[]
  writeOffs     WriteOff[]
  payrolls      Payroll[]
  purchaseOrder PurchaseOrder?

  @@index([entryNumber])
  @@index([entryDate])
  @@index([status])
  @@index([entryType])
  @@index([referenceType, referenceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id              String   @id @default(uuid())
  journalEntryId  String   @map("journal_entry_id")
  accountId       String   @map("account_id")
  debitAmount     Decimal  @default(0) @map("debit_amount") @db.Decimal(15, 2)
  creditAmount    Decimal  @default(0) @map("credit_amount") @db.Decimal(15, 2)
  lineDescription String?  @map("line_description") @db.Text
  branchId        String?  @map("branch_id")
  departmentId    String?  @map("department_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([branchId])
  @@map("journal_entry_lines")
}

model Expense {
  id              String    @id @default(uuid())
  expenseNumber   String    @unique @map("expense_number") // EXP-YYYYMMDD-XXXXXX
  expenseCategory String    @map("expense_category")
  expenseDate     DateTime  @map("expense_date")
  amount          Decimal   @map("amount") @db.Decimal(15, 2)
  taxAmount       Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount     Decimal   @map("total_amount") @db.Decimal(15, 2)
  paymentMethod   String?   @map("payment_method") // 'cash', 'transfer', 'petty-cash'
  bankAccountId   String?   @map("bank_account_id") // Chart of Account ID for bank
  branchId        String?   @map("branch_id")
  departmentId    String?   @map("department_id")
  glAccountId     String    @map("gl_account_id") // Expense account
  description     String    @db.Text
  receiptUrl      String?   @map("receipt_url")
  notes           String?   @db.Text
  status          String    @default("pending") // 'pending', 'approved', 'rejected', 'paid'
  requestedBy     String    @map("requested_by") // User ID
  approvedBy      String?   @map("approved_by") // User ID
  approvedAt      DateTime? @map("approved_at")
  rejectedBy      String?   @map("rejected_by") // User ID
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason") @db.Text
  paidAt          DateTime? @map("paid_at")
  paidBy          String?   @map("paid_by") // User ID
  journalEntryId  String?   @map("journal_entry_id") // Linked journal entry when paid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  glAccount    ChartOfAccount @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([expenseNumber])
  @@index([expenseDate])
  @@index([status])
  @@index([requestedBy])
  @@index([branchId])
  @@map("expenses")
}

model PettyCash {
  id             String    @id @default(uuid())
  fundNumber     String    @unique @map("fund_number") // PC-{BRANCH}-{YYYY}{MM}
  branchId       String    @map("branch_id")
  custodianId    String    @map("custodian_id") // User ID
  openingBalance Decimal   @map("opening_balance") @db.Decimal(15, 2)
  currentBalance Decimal   @map("current_balance") @db.Decimal(15, 2)
  periodStart    DateTime  @map("period_start")
  periodEnd      DateTime? @map("period_end")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  transactions PettyCashTransaction[]

  @@index([fundNumber])
  @@index([branchId])
  @@index([custodianId])
  @@index([isActive])
  @@map("petty_cash")
}

model PettyCashTransaction {
  id                String    @id @default(uuid())
  pettyCashId       String    @map("petty_cash_id")
  transactionNumber String    @unique @map("transaction_number") // PCT-YYYYMMDD-XXXXXX
  transactionType   String    @map("transaction_type") // 'disbursement', 'replenishment'
  amount            Decimal   @map("amount") @db.Decimal(15, 2)
  category          String
  description       String    @db.Text
  receiptUrl        String?   @map("receipt_url")
  balanceBefore     Decimal   @map("balance_before") @db.Decimal(15, 2)
  balanceAfter      Decimal   @map("balance_after") @db.Decimal(15, 2)
  recordedBy        String    @map("recorded_by") // User ID
  approvedBy        String?   @map("approved_by") // User ID
  approvedAt        DateTime? @map("approved_at")
  status            String    @default("pending") // 'pending', 'approved', 'rejected'
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  pettyCash PettyCash @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)

  @@index([pettyCashId])
  @@index([transactionNumber])
  @@index([transactionType])
  @@index([recordedBy])
  @@map("petty_cash_transactions")
}

model ARPayment {
  id              String   @id @default(uuid())
  invoiceId       String   @map("invoice_id") // SalesTransaction ID
  customerId      String   @map("customer_id")
  paymentNumber   String   @unique @map("payment_number") // ARP-YYYYMMDD-XXXXXX
  paymentDate     DateTime @map("payment_date")
  amount          Decimal  @map("amount") @db.Decimal(15, 2)
  paymentMethod   String   @map("payment_method") // 'cash', 'transfer', 'check'
  bankAccountId   String?  @map("bank_account_id") // Chart of Account ID
  referenceNumber String?  @map("reference_number") // Check number, transfer reference
  notes           String?  @db.Text
  journalEntryId  String?  @map("journal_entry_id")
  recordedBy      String   @map("recorded_by") // User ID
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bankAccount  ChartOfAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentNumber])
  @@index([paymentDate])
  @@map("ar_payments")
}

model WriteOff {
  id             String   @id @default(uuid())
  invoiceId      String   @map("invoice_id") // SalesTransaction ID
  customerId     String   @map("customer_id")
  writeOffNumber String   @unique @map("write_off_number") // WO-YYYYMMDD-XXXXXX
  writeOffDate   DateTime @map("write_off_date")
  amount         Decimal  @map("amount") @db.Decimal(15, 2)
  reason         String   @db.Text
  journalEntryId String?  @map("journal_entry_id")
  approvedBy     String   @map("approved_by") // User ID (CFO)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([customerId])
  @@index([writeOffNumber])
  @@map("write_offs")
}

// ============================================
// 9. CUSTOMER DEPOSITS
// ============================================

model CustomerDeposit {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  amount      Decimal  @db.Decimal(15, 2)  // positive = add, negative = deduct
  type        String   // 'return_credit', 'payment_used', 'refund'
  referenceId String?  @map("reference_id")  // SalesTransaction ID
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_deposits")
}

// ============================================
// 10. HR & PAYROLL MANAGEMENT
// ============================================

model Attendance {
  id                 String    @id @default(uuid())
  employeeId         String    @map("employee_id")
  date               DateTime  @db.Date
  branchId           String    @map("branch_id")
  clockIn            DateTime? @map("clock_in")
  clockOut           DateTime? @map("clock_out")
  clockInMethod      String?   @map("clock_in_method") // 'fingerprint', 'manual'
  clockOutMethod     String?   @map("clock_out_method")
  clockInLocation    String?   @map("clock_in_location") // GPS or branch
  clockOutLocation   String?   @map("clock_out_location")
  status             String    @default("present") // 'present', 'absent', 'leave', 'holiday'
  isLate             Boolean   @default(false) @map("is_late")
  lateMinutes        Int       @default(0) @map("late_minutes")
  isEarlyLeave       Boolean   @default(false) @map("is_early_leave")
  earlyLeaveMinutes  Int       @default(0) @map("early_leave_minutes")
  totalHours         Decimal?  @map("total_hours") @db.Decimal(5, 2)
  breakTime          Decimal?  @default(1) @map("break_time") @db.Decimal(5, 2) // Hours
  overtimeHours      Decimal?  @default(0) @map("overtime_hours") @db.Decimal(5, 2)
  overtimeApproved   Boolean   @default(false) @map("overtime_approved")
  overtimeApprovedBy String?   @map("overtime_approved_by") // User ID
  receiptNotes       String?   @map("receipt_notes") @db.Text
  internalNotes      String?   @map("internal_notes") @db.Text
  adjustedBy         String?   @map("adjusted_by") // User ID
  adjustmentReason   String?   @map("adjustment_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  overtimeRequest OvertimeRequest?

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([branchId])
  @@index([status])
  @@map("attendances")
}

model LeaveRequest {
  id                 String    @id @default(uuid())
  employeeId         String    @map("employee_id")
  leaveType          String    @map("leave_type") // 'annual', 'sick', 'emergency', 'unpaid'
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime  @map("end_date") @db.Date
  totalDays          Int       @map("total_days")
  reason             String    @db.Text
  attachmentUrl      String?   @map("attachment_url")
  status             String    @default("pending") // 'pending', 'approved', 'rejected', 'cancelled'
  requestedBy        String    @map("requested_by") // User ID
  approvedBy         String?   @map("approved_by") // User ID
  rejectedBy         String?   @map("rejected_by") // User ID
  rejectionReason    String?   @map("rejection_reason") @db.Text
  approvedAt         DateTime? @map("approved_at")
  rejectedAt         DateTime? @map("rejected_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledBy        String?   @map("cancelled_by") // User ID
  cancellationReason String?   @map("cancellation_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate])
  @@index([endDate])
  @@map("leave_requests")
}

model OvertimeRequest {
  id              String    @id @default(uuid())
  employeeId      String    @map("employee_id")
  attendanceId    String?   @unique @map("attendance_id")
  date            DateTime  @db.Date
  hours           Decimal   @db.Decimal(5, 2)
  reason          String    @db.Text
  estimatedAmount Decimal?  @map("estimated_amount") @db.Decimal(15, 2)
  status          String    @default("pending") // 'pending', 'approved', 'rejected'
  requestedBy     String    @map("requested_by") // User ID
  approvedBy      String?   @map("approved_by") // User ID
  approvedAt      DateTime? @map("approved_at")
  rejectedBy      String?   @map("rejected_by") // User ID
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("overtime_requests")
}

model Payroll {
  id              String    @id @default(uuid())
  employeeId      String    @map("employee_id")
  periodMonth     Int       @map("period_month")
  periodYear      Int       @map("period_year")
  payrollNumber   String    @unique @map("payroll_number") // PAY-YYYYMM-XXXXXX
  status          String    @default("draft") // 'draft', 'approved', 'paid', 'cancelled'
  totalEarnings   Decimal   @map("total_earnings") @db.Decimal(15, 2)
  totalDeductions Decimal   @map("total_deductions") @db.Decimal(15, 2)
  nettSalary      Decimal   @map("nett_salary") @db.Decimal(15, 2)
  attendanceDays  Int       @default(0) @map("attendance_days")
  lateCount       Int       @default(0) @map("late_count")
  lateMinutes     Int       @default(0) @map("late_minutes")
  earlyLeaveCount Int       @default(0) @map("early_leave_count")
  absenceCount    Int       @default(0) @map("absence_count")
  overtimeHours   Decimal   @default(0) @map("overtime_hours") @db.Decimal(5, 2)
  unpaidLeaveDays Int       @default(0) @map("unpaid_leave_days")
  calculatedBy    String    @map("calculated_by") // User ID
  calculatedAt    DateTime  @map("calculated_at")
  approvedBy      String?   @map("approved_by") // User ID (CHR)
  approvedBy2     String?   @map("approved_by_2") // User ID (CFO)
  approvedAt      DateTime? @map("approved_at")
  processedBy     String?   @map("processed_by") // User ID
  processedAt     DateTime? @map("processed_at")
  journalEntryId  String?   @map("journal_entry_id")
  payslipUrl      String?   @map("payslip_url")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components   PayrollComponent[]
  journalEntry JournalEntry?      @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([employeeId, periodMonth, periodYear])
  @@index([employeeId])
  @@index([periodMonth, periodYear])
  @@index([status])
  @@index([payrollNumber])
  @@map("payrolls")
}

model PayrollComponent {
  id        String   @id @default(uuid())
  payrollId String   @map("payroll_id")
  type      String // 'earning', 'deduction'
  name      String
  amount    Decimal  @db.Decimal(15, 2)
  formula   String?  @db.Text // Calculation formula
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@index([type])
  @@map("payroll_components")
}

model KPIRecord {
  id                     String   @id @default(uuid())
  employeeId             String   @map("employee_id")
  periodMonth            Int      @map("period_month")
  periodYear             Int      @map("period_year")
  salesTargetAchievement Decimal? @map("sales_target_achievement") @db.Decimal(15, 2)
  serviceQualityScore    Decimal? @map("service_quality_score") @db.Decimal(5, 2)
  customerSatisfaction   Decimal? @map("customer_satisfaction") @db.Decimal(5, 2)
  attendanceScore        Decimal? @map("attendance_score") @db.Decimal(5, 2)
  overallScore           Decimal  @map("overall_score") @db.Decimal(5, 2) // 0-100
  targetBonus            Decimal? @map("target_bonus") @db.Decimal(15, 2)
  calculatedBonus        Decimal? @map("calculated_bonus") @db.Decimal(15, 2)
  bonusMultiplier        Decimal? @default(1.0) @map("bonus_multiplier") @db.Decimal(3, 2)
  recordedBy             String   @map("recorded_by") // User ID
  notes                  String?  @db.Text
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodMonth, periodYear])
  @@index([employeeId])
  @@index([periodMonth, periodYear])
  @@index([overallScore])
  @@map("kpi_records")
}

// ============================================
// 11. PURCHASING & SUPPLIER MANAGEMENT
// ============================================

model PurchaseOrder {
  id                   String    @id @default(uuid())
  poNumber             String    @unique @map("po_number") // e.g., "PO-2025-001"
  supplierId           String    @map("supplier_id") // Customer with customerType='wholesale'
  branchId             String    @map("branch_id")
  status               String    @default("draft") // 'draft', 'pending', 'approved', 'ordered', 'partially_received', 'received', 'cancelled'
  orderDate            DateTime  @map("order_date")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  paymentTerms         String?   @map("payment_terms") // e.g., "Net 30", "COD"
  paymentTermDays      Int?      @map("payment_term_days") // Days until payment due
  subtotal             Decimal   @map("subtotal") @db.Decimal(15, 2)
  discountAmount       Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  shippingCost         Decimal   @default(0) @map("shipping_cost") @db.Decimal(15, 2)
  totalAmount          Decimal   @map("total_amount") @db.Decimal(15, 2)
  notes                String?   @db.Text
  supplierConfirmed    Boolean   @default(false) @map("supplier_confirmed")
  supplierConfirmedAt  DateTime? @map("supplier_confirmed_at")
  createdBy            String    @map("created_by") // User ID
  approvedBy           String?   @map("approved_by") // User ID (CSO)
  approvedBy2          String?   @map("approved_by_2") // User ID (CFO, for > Rp 5M)
  approvedAt           DateTime? @map("approved_at")
  orderedBy            String?   @map("ordered_by") // User ID
  orderedAt            DateTime? @map("ordered_at")
  cancelledBy          String?   @map("cancelled_by") // User ID
  cancelledAt          DateTime? @map("cancelled_at")
  cancellationReason   String?   @map("cancellation_reason") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  supplier       Customer            @relation("PurchaseOrderSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]
  journalEntryId String?             @unique @map("journal_entry_id")
  journalEntry   JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([poNumber])
  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([orderDate])
  @@index([createdBy])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String   @map("purchase_order_id")
  productId        String   @map("product_id")
  quantityOrdered  Decimal  @map("quantity_ordered") @db.Decimal(15, 3)
  quantityReceived Decimal  @default(0) @map("quantity_received") @db.Decimal(15, 3)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(15, 2)
  discountPercent  Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  subtotal         Decimal  @map("subtotal") @db.Decimal(15, 2)
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  GoodsReceiptItem GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                 String    @id @default(uuid())
  grNumber           String    @unique @map("gr_number") // e.g., "GR-2025-001"
  purchaseOrderId    String?   @map("purchase_order_id") // Optional, can receive without PO
  branchId           String    @map("branch_id")
  receiptDate        DateTime  @map("receipt_date")
  status             String    @default("draft") // 'draft', 'received', 'inspected', 'approved', 'rejected', 'cancelled'
  inspectionStatus   String?   @map("inspection_status") // 'pending', 'passed', 'failed', 'partial'
  inspectionNotes    String?   @map("inspection_notes") @db.Text
  variancePercent    Decimal?  @map("variance_percent") @db.Decimal(5, 2) // Variance from PO (< 2% acceptable)
  receiptNotes       String?   @map("receipt_notes") @db.Text
  internalNotes      String?   @map("internal_notes") @db.Text
  receivedBy         String    @map("received_by") // User ID
  inspectedBy        String?   @map("inspected_by") // User ID
  inspectedAt        DateTime? @map("inspected_at")
  approvedBy         String?   @map("approved_by") // User ID
  approvedAt         DateTime? @map("approved_at")
  rejectedBy         String?   @map("rejected_by") // User ID
  rejectedAt         DateTime? @map("rejected_at")
  rejectionReason    String?   @map("rejection_reason") @db.Text
  cancelledBy        String?   @map("cancelled_by") // User ID
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  branch        Branch             @relation("GoodsReceiptBranch", fields: [branchId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([grNumber])
  @@index([purchaseOrderId])
  @@index([branchId])
  @@index([status])
  @@index([receiptDate])
  @@index([receivedBy])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String    @id @default(uuid())
  goodsReceiptId      String    @map("goods_receipt_id")
  purchaseOrderItemId String?   @map("purchase_order_item_id") // Link to PO item if receiving from PO
  productId           String    @map("product_id")
  quantityReceived    Decimal   @map("quantity_received") @db.Decimal(15, 3)
  quantityAccepted    Decimal   @map("quantity_accepted") @db.Decimal(15, 3)
  quantityRejected    Decimal   @default(0) @map("quantity_rejected") @db.Decimal(15, 3)
  unitPrice           Decimal   @map("unit_price") @db.Decimal(15, 2)
  batchNumber         String?   @map("batch_number")
  serialNumber        String?   @map("serial_number")
  expiryDate          DateTime? @map("expiry_date")
  inspectionStatus    String?   @map("inspection_status") // 'pending', 'passed', 'failed', 'partial'
  inspectionNotes     String?   @map("inspection_notes") @db.Text
  notes               String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  product           Product            @relation("GoodsReceiptItemProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
  @@map("goods_receipt_items")
}
